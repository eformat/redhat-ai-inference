schemaVersion: 2.2.0
metadata:
  name: maas-chat-client
  displayName: "Module 4: MaaS Chat Client"
  description: "Python workspace pre-loaded with the maas-chat-client sample application for Module 4 of the Red Hat AI Inference workshop."
attributes:
  che-code.eclipse.org/vscode-preferences:
    security.workspace.trust.enabled: false
components:
  - name: maas-client-tools
    container:
      # Verified anonymously-pullable (quay.io/rhpds/openshowroom-terminal-ocp
      # went private). Lean and already cached on the workshop nodes.
      image: registry.access.redhat.com/ubi9/python-311:latest
      memoryLimit: 2Gi
      memoryRequest: 512Mi
      cpuRequest: 500m
      mountSources: true
      sourceMapping: /projects
commands:
  - id: install-oc
    exec:
      component: maas-client-tools
      commandLine: |
        mkdir -p $HOME/.local/bin
        curl -fsSL https://mirror.openshift.com/pub/openshift-v4/clients/ocp/stable/openshift-client-linux.tar.gz -o /tmp/oc.tar.gz
        tar -xzf /tmp/oc.tar.gz -C $HOME/.local/bin oc kubectl
        rm -f /tmp/oc.tar.gz
        oc version --client
      workingDir: /projects
      label: "Install the oc CLI"
events:
  postStart:
    - install-oc
projects:
  - name: redhat-ai-inference
    git:
      remotes:
        origin: https://github.com/rhpds/redhat-ai-inference.git
      checkoutFrom:
        revision: main
